# Copy to .env.local and fill in. Never commit a filled-in copy.
#
# Privy. App ID is public by design (VITE_ prefix is in the client bundle).
# The secret is SERVER ONLY and never belongs in a VITE_ variable.
VITE_PRIVY_APP_ID=
# PRIVY_APP_SECRET=
#
# Fast, keyed RPC for the API. SERVER ONLY: a keyed url in these vars is read
# by apps/api/src/rpc.ts and never shipped to the browser, because chains.ts is
# imported by the web app too and a key there would leak to every client. Leave
# empty to use Monad's public testnet RPC.
TESTNET_RPC_URL=
TESTNET_RPC_WS_URL=
#
# Writing runs to DiskRegistry is OFF unless this is exactly "1". Off is not an
# error: POST /api/runs still answers 200 with recorded:false and a reason, so a
# screen calling it cannot break. CLAUDE.md: nothing in the demo path may fail
# on stage.
ONCHAIN_RUNS=0

# The key the API signs run records with. SERVER ONLY, testnet, holds faucet gas
# and nothing else. The player never signs anything in this build, which is why
# the API reports signedBy:"keeper" and a screen must not imply otherwise.
# It must own the diskId it writes to, or the contract reverts with NotDiskOwner.
KEEPER_PRIVATE_KEY=

# Deploys and seeds our own Liquidity Book (contracts/). Read by forge only,
# never by the app, and needed only when re-running those scripts:
#
#   forge script script/DeployLiquidityBook.s.sol --rpc-url <testnet> --broadcast
#   forge script script/SeedPools.s.sol           --rpc-url <testnet> --broadcast
#
# Both refuse to run on any chain that is not Monad testnet or a local anvil.
DEPLOYER_PRIVATE_KEY=

# Standalone API port. Ignored when the API is mounted inside the web app,
# which is how the demo runs it.
API_PORT=3001
